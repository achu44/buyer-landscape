ANTHROPIC_API_KEY=
# SEC requires automated EDGAR traffic to identify itself with a contact
# address, and throttles or blocks requests that don't.
EDGAR_USER_AGENT=your-project-name your.email@example.com
# Brave Web Search, for the evidence that never reaches a filing (private
# buyers, sponsor portfolio pages, trade press). Free tier at
# https://api-dashboard.search.brave.com/. Optional: without it `web_search`
# reports itself unconfigured and the run sources evidence from EDGAR alone.
BRAVE_SEARCH_API_KEY=
